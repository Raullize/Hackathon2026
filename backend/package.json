{
  "name": "@careflow/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @careflow/contracts build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @careflow/contracts build",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @careflow/contracts build",
    "test": "jest --config jest.config.cjs",
    "pretest:e2e": "pnpm --filter @careflow/contracts build",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv run -f ../.env -- prisma migrate dev",
    "db:deploy": "dotenv run -f ../.env -- prisma migrate deploy",
    "db:seed": "dotenv run -f ../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv run -f ../.env -- prisma studio"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@careflow/contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "helmet": "8.3.0",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "dotenv-cli": "11.0.0",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
