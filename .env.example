NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_DB=hackathon
POSTGRES_PORT=55432
DATABASE_URL=postgresql://hackathon:hackathon@localhost:55432/hackathon?schema=public

JWT_SECRET=dev-only-change-me-please-32-chars-min
JWT_EXPIRES_IN=8h

LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TEMPERATURE=0.7
LLM_TIMEOUT_MS=20000
# Tempo máximo (ms) da extração de laudo pelo Gemini. Ao estourar, cai para a regra
# local (mock). Padrão 8000 [SUPOSIÇÃO]. Ainda não é lido pelo env.ts (entra no D30-002).
REPORT_EXTRACTION_TIMEOUT_MS=8000

THROTTLE_TTL=60000
THROTTLE_LIMIT=20

DEMO_MODE=false
REPORT_EXTRACTION_TIMEOUT_MS=8000

SEED_USER_NAME=Demo User
SEED_USER_EMAIL=demo@careflow.dev
SEED_USER_PASSWORD=demo1234

VITE_API_URL=http://localhost:3000/api
