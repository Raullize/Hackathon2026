{
  "name": "careflow",
  "version": "0.1.0",
  "private": true,
  "description": "CareFlow: aplicação de acompanhamento dos prazos legais do câncer",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "predev": "pnpm --filter @careflow/contracts build",
    "dev": "pnpm --parallel --filter @careflow/backend --filter @careflow/frontend dev",
    "dev:backend": "pnpm --filter @careflow/backend dev",
    "dev:frontend": "pnpm --filter @careflow/frontend dev",
    "prebuild": "pnpm --filter @careflow/contracts build",
    "build": "pnpm --filter @careflow/backend build && pnpm --filter @careflow/frontend build",
    "lint": "eslint backend/src backend/test frontend/src packages/contracts/src scripts",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm --filter @careflow/contracts build",
    "test": "pnpm --filter @careflow/backend test && pnpm --filter @careflow/frontend test",
    "test:backend": "pnpm --filter @careflow/backend test",
    "test:e2e": "pnpm --filter @careflow/backend test:e2e",
    "test:frontend": "pnpm --filter @careflow/frontend test",
    "db:generate": "pnpm --filter @careflow/backend db:generate",
    "db:migrate": "pnpm --filter @careflow/backend db:migrate",
    "db:deploy": "pnpm --filter @careflow/backend db:deploy",
    "db:seed": "pnpm --filter @careflow/backend db:seed",
    "db:studio": "pnpm --filter @careflow/backend db:studio",
    "smoke": "node scripts/smoke.mjs",
    "docker:up": "docker compose up -d db",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
